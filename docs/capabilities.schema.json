{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capabilities structural schema v1",
  "$comment": "Cross-field invariants, byte limits, lexical ordering, NFC and u64 bounds are normative in INTERFACE-CONTRACT.md and validated by the Rust/Python checkers.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_versions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "object_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_./-]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "supported_features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_./-]+$"
      },
      "uniqueItems": true
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_./-]+$"
      },
      "uniqueItems": true
    },
    "max_object_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "max_frame_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "compression": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_./-]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "signature_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_./-]+$"
      },
      "uniqueItems": true
    },
    "ref_transactions": {
      "type": "boolean"
    },
    "partial": {
      "type": "boolean"
    },
    "shallow": {
      "type": "boolean"
    },
    "durability": {
      "enum": [
        "none",
        "single-node-durable",
        "replicated-durable"
      ]
    },
    "replication_policy": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^k1:b3:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "protocol_versions",
    "object_formats",
    "supported_features",
    "required_features",
    "max_object_bytes",
    "max_frame_bytes",
    "compression",
    "signature_formats",
    "ref_transactions",
    "partial",
    "shallow",
    "durability"
  ],
  "additionalProperties": false
}
